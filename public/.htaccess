#     Header set X-Frame-Options "DENY"
    
#     # Politique de référent
#     Header set Referrer-Policy "strict-origin-when-cross-origin"
    
#     # Content Security Policy (CSP) - Protection XSS avancée
#     # Note: Le CSP est géré par Middleware::securityHeaders() côté backend
#     # Pour les fichiers statiques servis directement par Apache, utiliser un CSP permissif
#     # car les scripts sont dans des fichiers séparés (pas inline) en production
#     # unsafe-inline pour styles est nécessaire pour les styles inline dans index.html
#     # unsafe-eval est retiré car non nécessaire en production
