# Perf prod : activer si possible mod_deflate (gzip), mod_brotli (brotli), mod_expires, mod_headers, mod_rewrite.
# Brotli : souvent via « a2enmod brotli » ou équivalent hébergeur (sinon gzip seul suffit).

<IfModule mod_headers.c>
  # Sécurité/Perf basiques
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
  Header always set X-Robots-Tag "noindex, nofollow" "expr=%{REQUEST_URI} =~ m#^/(admin)(/.*)?$#"
  # HSTS : HTTPS direct OU derrière proxy (X-Forwarded-Proto)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=(%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https') && %{HTTP_HOST} =~ m#^(www\\.)?afboxingclub86\\.com$#"
</IfModule>

# NOTE:
# On évite un "SPA fallback" générique avant la config principale ci-dessous,
# sinon certaines requêtes /api/* peuvent être réécrites vers index.html (HTML)
# au lieu d'atteindre le backend (JSON).

<IfModule mod_deflate.c>
  # GZIP — types fréquents (fonts + JSON + SVG)
  AddOutputFilterByType DEFLATE text/plain text/html text/css text/xml
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2 application/font-woff application/font-woff2
</IfModule>

<IfModule mod_brotli.c>
  # Brotli (prioritaire si mod_brotli chargé — meilleure compression que gzip)
  AddOutputFilterByType BROTLI_COMPRESS text/plain text/html text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript application/x-javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
  AddOutputFilterByType BROTLI_COMPRESS font/ttf font/otf font/woff font/woff2 application/font-woff application/font-woff2
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Cache long pour fichiers versionnés (hash) générés par Vite
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  # HTML court (pour que les updates arrivent vite)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Cache long + immutable : noms de fichiers Vite avec hash (dont tout /assets/*.js, *.css)
  <FilesMatch "\.(css|js|mjs|map|png|jpe?g|gif|svg|webp|mp4|woff2?|ttf|eot|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ============================================
# Configuration .htaccess pour MattingMatch
# Production - Optimisé pour Hostinger
# ============================================

# Activer le moteur de réécriture
<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteBase :
    # Ne pas forcer "/" ici : en sous-dossier (ex: /AF/AFBoxing/), ça casse les reload de routes.
    # Apache calcule généralement la base automatiquement en contexte .htaccess.

    # IMPORTANT (prod/Apache/FastCGI) :
    # Préserve l'en-tête Authorization pour que PHP puisse lire le Bearer token.
    # Sans ça, l'API peut répondre "Authorization header missing" même si le navigateur envoie le header.
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    
    # Rediriger HTTP → HTTPS uniquement sur le domaine de production
    # (ne pas activer sur localhost / XAMPP)
    RewriteCond %{HTTP_HOST} ^(www\.)?afboxingclub86\.com$ [NC]
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Canonique www → apex (production uniquement)
    RewriteCond %{HTTP_HOST} ^www\.afboxingclub86\.com$ [NC]
    RewriteRule ^(.*)$ https://afboxingclub86.com/$1 [L,R=301]
    
    # ============================================
    # PRIORITÉ 1 : Servir les fichiers uploads
    # ============================================
    # Servir les fichiers uploads depuis backend/public/uploads
    # Supporte aussi un déploiement en sous-dossier: /AF/AFBoxing/uploads/...
    RewriteCond %{REQUEST_URI} (^|/)uploads/
    RewriteRule ^(.*?/)?uploads/(.*)$ backend/public/uploads/$2 [L]
    
    # ============================================
    # PRIORITÉ 2 : Ne pas traiter /backend directement
    # ============================================
    RewriteCond %{REQUEST_URI} (^|/)backend/
    RewriteRule ^ - [L]
    
    # ============================================
    # PRIORITÉ 3a : Exception pour les fichiers de debug PHP
    # ============================================
    # Servir directement les fichiers debug_*.php depuis backend/public/
    RewriteRule ^(.*?/)?api/(debug_[^/]+\.php)$ backend/public/$2 [L]
    
    # ============================================
    # PRIORITÉ 3b : API - Rediriger /api vers /backend/public/index.php
    # ============================================
    # Supporte aussi un déploiement en sous-dossier: /AF/AFBoxing/api/...
    RewriteCond %{REQUEST_URI} (^|/)api(/|$)
    RewriteRule ^.*$ backend/public/index.php [L]

    # Forcer la racine à servir le build (dist/) ou (index.html) selon la structure déployée
    RewriteCond %{REQUEST_URI} ^/?$
    RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
    RewriteRule ^$ dist/index.html [L]

    RewriteCond %{REQUEST_URI} ^/?$
    RewriteCond %{DOCUMENT_ROOT}/index.html -f
    RewriteRule ^$ index.html [L]
    
    # ============================================
    # PRIORITÉ 3c : Crawlers — robots.txt / sitemap.xml (évite le fallback SPA)
    # ============================================
    RewriteCond %{REQUEST_URI} (^|/)robots\.txt$
    RewriteCond %{DOCUMENT_ROOT}/dist/robots.txt -f
    RewriteRule ^.*$ dist/robots.txt [L]

    RewriteCond %{REQUEST_URI} (^|/)robots\.txt$
    RewriteCond %{DOCUMENT_ROOT}/robots.txt -f
    RewriteRule ^.*$ robots.txt [L]

    RewriteCond %{REQUEST_URI} (^|/)sitemap\.xml$
    RewriteCond %{DOCUMENT_ROOT}/dist/sitemap.xml -f
    RewriteRule ^.*$ dist/sitemap.xml [L]

    RewriteCond %{REQUEST_URI} (^|/)sitemap\.xml$
    RewriteCond %{DOCUMENT_ROOT}/sitemap.xml -f
    RewriteRule ^.*$ sitemap.xml [L]
    
    # ============================================
    # PRIORITÉ 4 : Servir les fichiers statiques
    # ============================================
    # Servir les fichiers statiques buildés depuis dist/ (supporte aussi un sous-dossier)
    RewriteCond %{REQUEST_URI} (^|/)(assets/[^?]+|vite\.svg|[^?]+\.(css|js|mjs|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|webp))$
    RewriteCond %{DOCUMENT_ROOT}/dist/%2 -f
    RewriteRule ^.*$ dist/%2 [L]
    
    # Si le fichier existe directement (production), le servir
    RewriteCond %{REQUEST_URI} ^/(assets/|vite\.svg|.*\.(css|js|mjs|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|webp))$
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    
    # ============================================
    # PRIORITÉ 5 : Si le fichier existe directement, le servir
    # ============================================
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    
    # ============================================
    # PRIORITÉ 6 : Si c'est un dossier qui existe, ne pas réécrire
    # ============================================
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # ============================================
    # PRIORITÉ 7 : SPA React - Rediriger vers index.html
    # ============================================
    # Pour toutes les autres requêtes (SPA), servir dist/index.html si présent,
    # sinon fallback sur index.html (quand le contenu de dist a été copié à la racine).
    RewriteCond %{REQUEST_URI} !^(.*/)?api/
    RewriteCond %{REQUEST_URI} !^(.*/)?backend/
    RewriteCond %{REQUEST_URI} !^(.*/)?uploads/
    RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
    RewriteRule ^(.*)$ dist/index.html [L]

    RewriteCond %{REQUEST_URI} !^(.*/)?api/
    RewriteCond %{REQUEST_URI} !^(.*/)?backend/
    RewriteCond %{REQUEST_URI} !^(.*/)?uploads/
    RewriteCond %{DOCUMENT_ROOT}/index.html -f
    RewriteRule ^(.*)$ index.html [L]
</IfModule>

# ============================================
# Désactiver la liste des répertoires
# ============================================
Options -Indexes

# ============================================
# Protéger les fichiers sensibles
# ============================================
<FilesMatch "\.(env|log|ini|conf|htaccess|htpasswd|bak|backup|sql|db|md)$">
    Require all denied
</FilesMatch>

# Protéger les fichiers de configuration
<FilesMatch "^(config|database|auth|security)\.php$">
    Require all denied
</FilesMatch>

# ============================================
# Headers de sécurité
# ============================================
