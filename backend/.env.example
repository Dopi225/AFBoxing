APP_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=afboxing
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Secret fort (≥ 32 caractères aléatoires) pour signer les JWT
# Générer avec : php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# Origines autorisées pour le navigateur (séparées par des virgules)
# En production : domaines réels uniquement, jamais *
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Exemple prod : CORS_ALLOWED_ORIGINS=https://afboxingclub86.com,https://www.afboxing86.com

# Mettre à 1 pour refuser toute origine hors liste même en développement
# CORS_STRICT=0

# APP_ENV=production active les messages d'erreur génériques et CORS strict

# Derrière un reverse proxy qui envoie X-Forwarded-For / X-Real-IP
# TRUSTED_PROXY=0

# --- Envoi d'emails (réponses aux messages depuis le CRM) ---
# L'adresse et le nom visibles par le destinataire se règlent dans
# Admin → Informations du club (Paramètres). Ici : uniquement le serveur SMTP.
# MAIL_ENABLED=0 désactive l'envoi (utile en développement local).
MAIL_ENABLED=1
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls (port 587), ssl (port 465), ou vide pour aucun chiffrement
MAIL_ENCRYPTION=tls
